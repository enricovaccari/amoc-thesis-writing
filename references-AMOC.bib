@article{vanwestenPhysicsbasedEarlyWarning2024,
  title = {Physics-Based Early Warning Signal Shows That {{AMOC}} Is on Tipping Course},
  author = {family=Westen, given=René M., prefix=van, useprefix=true and Kliphuis, Michael and Dijkstra, Henk A.},
  date = {2024-02-09},
  journaltitle = {Science Advances},
