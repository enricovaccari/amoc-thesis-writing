  author = {{Ben I Moat} and {David Smeed} and {Darren Rayner} and {William E Johns} and {Ryan H Smith} and {Denis L Volkov} and {Shane Elipot} and {Tillys Petit} and {Jules B Kajtar} and {Molly O Baringer} and {Julie Collins}},
  date = {2026},
