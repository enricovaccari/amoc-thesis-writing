@article{clementVerticalStructureEddies2014,
  title = {Vertical Structure of Eddies and {{{\textsc{R}}}} Ossby Waves, and Their Effect on the {{{\textsc{A}}}} Tlantic Meridional Overturning Circulation at 26.5°{{N}}},
  shorttitle = {Vertical Structure of Eddies And},
  author = {Clément, L. and Frajka‐Williams, E. and Szuts, Z. B. and Cunningham, S. A.},
  date = {2014-09},
  journaltitle = {Journal of Geophysical Research: Oceans},
  shortjournal = {J. Geophys. Res. Oceans},
  volume = {119},
  number = {9},
  pages = {6479--6498},
  issn = {2169-9275, 2169-9291},
  doi = {10.1002/2014JC010146},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2014JC010146},
  urldate = {2026-06-11},
  abstract = {Abstract                            The meridional overturning circulation (MOC) at                              in the Atlantic has a standard deviation of 4.9 Sv and contains large fluctuations at subannual periods. The geostrophic component of the MOC is believed to be influenced on subannual time scales by eddies and Rossby waves. To quantify this effect, the vertical structure and surface characteristics of westward propagating signals are studied using altimetric data and full‐depth mooring measurements from the RAPID array at                              . Westward propagating features are observed in the western North Atlantic in both data sets and have periods of 80–250 days in the first baroclinic mode. These features are still observed by the RAPID moorings 20 km offshore of the western boundary. The western boundary also exhibits deep variability characterized by enhanced energy in higher baroclinic modes. The effect of eddies and Rossby waves on the geostrophic transport is quantified by representing their vertical structure with the first baroclinic mode. In total, 42\% of the variance of the transbasin thermocline transport inferred from geostrophic calculations at                              can be attributed to first mode variability, which is associated with eddies and Rossby waves at periods of 80–250 days. The standard deviation of the transbasin thermocline transport due to eddies and Rossby waves is estimated to be 2.6 Sv.                        ,              Key Points                                                                Eddies/Rossby waves explain 42\% of the upper mid‐ocean transport variance                                                     Eddies/Rossby waves exhibit first baroclinic mode structure at 80–250 day periods                                                     At the boundary, higher baroclinic modes also contain substantial energy},
  langid = {english}
}

